DATABASE_URL="file:./dev.db"
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Chave que cifra nomes, telefones e e-mails no banco (32 bytes em base64). OBRIGATÓRIA.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PERDER ESTA CHAVE = PERDER OS DADOS. Guarde uma cópia em lugar seguro, fora do servidor.
DADOS_CHAVE=""
# Endereço público do site em produção (ex.: https://barbearia.com.br). Necessário atrás de proxy/HTTPS.
# AUTH_URL="https://localhost:3443"

# ---------- Cadastro e confirmação de e-mail ----------
# Provedor de e-mail por API (o Railway bloqueia SMTP no plano Hobby). Use UM dos dois.
# Sem nenhum, o link de confirmação só aparece no log do servidor.
# RESEND_API_KEY=""
# BREVO_API_KEY=""
# Remetente. No Resend, precisa ser de um domínio verificado lá para enviar a qualquer pessoa.
# EMAIL_REMETENTE="Barbearia <nao-responda@seudominio.com>"

# ---------- Entrar com Google ----------
# Crie em https://console.cloud.google.com/apis/credentials (ID do cliente OAuth, tipo "Aplicativo da Web").
# URI de redirecionamento autorizado: <endereço do site>/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
