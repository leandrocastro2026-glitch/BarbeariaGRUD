generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// nome, telefone e email ficam CIFRADOS (AES-256-GCM, ver src/lib/cripto.ts).
model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String
  email        String?
  /// HMAC do e-mail: permite busca exata e garante e-mail único sem guardar o e-mail em claro.
  emailHash    String?       @unique
  criadoEm     DateTime      @default(now())
  agendamentos Agendamento[]
  /// Conta de login do próprio cliente (perfil CLIENTE), se ele se cadastrou pelo site.
  usuario      Usuario?
}

model Barbeiro {
  id            Int           @id @default(autoincrement())
  nome          String
  /// CIFRADO
  telefone      String
  especialidade String?
  ativo         Boolean       @default(true)
  criadoEm      DateTime      @default(now())
  agendamentos  Agendamento[]
}

model Servico {
  id            Int           @id @default(autoincrement())
  nome          String        @unique
  precoCentavos Int
  duracaoMin    Int
  criadoEm      DateTime      @default(now())
  agendamentos  Agendamento[]
}

/// status: AGENDADO | CONCLUIDO | CANCELADO (validado com Zod; SQLite não tem enum nativo)
model Agendamento {
  id         Int      @id @default(autoincrement())
  clienteId  Int
  barbeiroId Int
  servicoId  Int
  inicio     DateTime
  fim        DateTime
  status     String   @default("AGENDADO")
  /// CIFRADO
  observacao String?
  criadoEm   DateTime @default(now())

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Restrict)
  servico  Servico  @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@index([barbeiroId, inicio])
  @@index([inicio])
}

/// perfil: ADMIN | RECEPCAO | CLIENTE (validado com Zod)
/// nome e email ficam CIFRADOS; a busca no login usa emailHash.
model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String
  emailHash String?  @unique
  /// Nulo em contas criadas só pelo Google (não têm senha local).
  senhaHash String?
  perfil    String   @default("RECEPCAO")
  ativo     Boolean  @default(true)
  /// Incrementa ao trocar senha, perfil ou desativar: invalida sessões (JWT) já emitidas.
  versaoSessao Int   @default(0)
  /// Nulo enquanto o dono não confirmou o e-mail pelo link enviado no cadastro.
  emailVerificadoEm DateTime?
  /// "sub" da conta Google vinculada.
  googleId  String?  @unique
  /// Só para perfil CLIENTE: o cadastro de cliente que esta conta representa.
  clienteId Int?     @unique
  criadoEm  DateTime @default(now())

  cliente           Cliente?           @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  tokensVerificacao TokenVerificacao[]
}

/// Link de confirmação de e-mail. Guardamos só o SHA-256 do token; o token em si vai apenas no e-mail.
model TokenVerificacao {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  hashToken String   @unique
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// Horário de funcionamento da agenda online, um registro por dia da semana (0 = domingo ... 6 = sábado).
/// Sem registros, vale o padrão de src/lib/horario-funcionamento.ts.
model HorarioDia {
  diaSemana Int     @id
  aberto    Boolean @default(true)
  /// "HH:MM" no horário de Brasília
  abre      String  @default("09:00")
  fecha     String  @default("19:00")
}

/// Regras gerais da agenda online (registro único, id = 1).
model ConfigAgenda {
  id                     Int @id @default(1)
  intervaloMin           Int @default(30)
  antecedenciaMin        Int @default(30)
  diasAFrente            Int @default(30)
  maxAgendamentosFuturos Int @default(3)
}
